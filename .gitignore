# ==============================================================================
# Video Incident Analyzer — .gitignore
# ==============================================================================

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.eggs/
*.egg

# Virtual environments
venv/
.venv/
env/

# Environment files (contain secrets)
.env

# Node.js
node_modules/
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build outputs
frontend/dist/
*.tsbuildinfo

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Test artifacts
backend/tests/test_video.mp4

# Temp uploads (should never be committed)
/tmp/
