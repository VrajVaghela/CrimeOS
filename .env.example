# ==============================================================================
# Video Incident Analyzer — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values. Never commit .env to VCS.

# Google Gemini API key for video analysis (required, no default — fails at startup if missing)
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL connection string for async access via asyncpg
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/video_analyzer

# Redis connection string for Celery broker and result backend
REDIS_URL=redis://redis:6379/0

# HMAC signing key for the tamper-evident ledger (required, no default — fails at startup if missing)
# NOTE: In production, replace with KMS/HSM-backed signing — see utils/crypto.py
LEDGER_SIGNING_KEY=40d46fba477b48ab97c6d194c65f5e8a701d6c418b02e704bda3d627f77c8025

# Maximum upload size in megabytes (default: 500 MB)
MAX_UPLOAD_SIZE_MB=500

# Directory for temporary video uploads (default: /tmp/video-uploads)
TEMP_UPLOAD_DIR=/tmp/video-uploads
