# Database
POSTGRES_USER=crime_os_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=crime_os
DATABASE_URL=postgresql+psycopg://crime_os_user:changeme@localhost:5432/crime_os

# Gemini API
GEMINI_API_KEY=<your-key>
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Auth
JWT_SECRET=<dev-secret-change-in-prod>

# Email (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail>
SMTP_PASSWORD=<app-password>
DEMO_PROVIDER_INBOX=<receiver-email>

# Frontend
# Must be reachable from the user's BROWSER, not from inside the container.
# Baked into the JS bundle at image build time (docker/Dockerfile.frontend ARG).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the API (CORS).
# Set this to your deployed frontend origin, e.g. https://crimeos.example.gov.in
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
