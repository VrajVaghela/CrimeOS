# Database
POSTGRES_USER=crime_os_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=crime_os
DATABASE_URL=postgresql+psycopg://crime_os_user:changeme@localhost:5432/crime_os

# Gemini API
GEMINI_API_KEY=<your-key>
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro

# Local models (Ollama + faster-whisper)
# Text, structured extraction, embeddings and audio ASR run locally; vision (image / PDF /
# video) has no local model and always uses Gemini. All keys below are optional — the
# defaults in backend/app/config.py work as-is when Ollama is on the default port.
#
# Start Ollama with models stored off the C: drive:
#   set OLLAMA_MODELS=E:\models\ollama && E:\programs\ollama\ollama.exe serve
#
# IMPORTANT: after changing EMBEDDING_PROVIDER, run `python -m app.scripts.reembed_sop`.
# nomic-embed-text and text-embedding-004 are both 768-dim, so a mismatch raises no error —
# retrieval just silently returns wrong results.
EMBEDDING_PROVIDER=ollama
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen2.5:3b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
# Comma-separated `purpose` prefixes to keep on Gemini. Empty = all text runs locally.
# Set to `translate_` if page loads feel slow: translate_batch runs up to 25 calls serially.
LOCAL_LLM_SKIP_PURPOSE_PREFIXES=
WHISPER_ENABLED=true
WHISPER_MODEL_DIR=E:/models/whisper/faster-whisper-medium
# CUDA is ~8.6x faster than CPU (measured: 10.8s vs 92.5s for 57s of Hindi audio) and needs
#   pip install nvidia-cublas-cu12 nvidia-cudnn-cu12
# Falls back to cpu/int8 automatically if those are missing, so cuda is safe to leave on.
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=float16
# Languages Whisper medium transcribes too poorly to trust — these escalate to Gemini.
WHISPER_ESCALATE_LANGUAGES=gu

# Auth
JWT_SECRET=<dev-secret-change-in-prod>

# Email (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<your-gmail>
SMTP_PASSWORD=<app-password>
DEMO_PROVIDER_INBOX=<receiver-email>

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Video & File Upload Limit (in MB, max 2000 for Gemini File API)
MAX_UPLOAD_SIZE_MB=2000
